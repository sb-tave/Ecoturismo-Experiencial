# ===== Servidor =====
NODE_ENV=development
PORT=3000
APP_TIMEZONE=America/Bogota
# Orígenes permitidos por CORS (el frontend), separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Detrás de un proxy o balanceador (producción): true
TRUST_PROXY=false
# Redirigir HTTP a HTTPS (RNF-01). En producción: true
FORCE_HTTPS=false

# ===== Base de datos (PostgreSQL) =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecoturismo
# Las pruebas usan SIEMPRE esta base (su nombre debe contener "test")
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecoturismo_test
DB_POOL_MAX=10
DB_SSL=false

# ===== Seguridad =====
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32-o-mas-caracteres
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20

# ===== Reglas de negocio =====
POLICY_VERSION=v1.0
# Minutos que se retiene una reserva pendiente de pago (RF-22)
RESERVATION_HOLD_MINUTES=15
MAX_STAY_DAYS=30
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60

# ===== Pagos simulados =====
# true: el cliente puede forzar el resultado (APROBADO o RECHAZADO) para demostraciones
PAYMENT_ALLOW_FORCED_RESULT=true
# Probabilidad de aprobación cuando no se fuerza el resultado
PAYMENT_APPROVAL_RATE=0.9

# ===== Imágenes =====
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
MAX_PHOTOS_PER_SERVICE=10
# URL pública del backend (para construir enlaces absolutos a las imágenes)
PUBLIC_BASE_URL=http://localhost:3000

# ===== Correo (opcional; sin SMTP los correos solo se registran en el log) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Eco Turismo Experiencial <no-reply@ecoturismo.local>"

# ===== Datos iniciales (npm run seed) =====
ADMIN_EMAIL=admin@ecoturismo.local
ADMIN_PASSWORD=CambiaEstaClave123

# ===== Logs =====
LOG_LEVEL=debug
LOG_PRETTY=true
